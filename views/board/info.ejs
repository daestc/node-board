<!doctype html>
<html lang="ko">

<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>board_view</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
	<link href="/css/style.css" rel="stylesheet">
</head>

<body>

	<!-- 헤더 -->
	<%- include('../partials/header') %>

	<!-- 메인 -->
	<main class="container my-4">
		<article class="card shadow-sm">
			<div class="card-body p-4">
				<h3 class="mb-2"><%= board.title %></h3>
				<div class="small text-muted mb-3">작성자: <%= board.author.name %> · <%= board.createdAt.toLocaleDateString() %></div>

				<% if(board.file === null) { %>
					<!-- 카드에 이미지가 없을 경우 -->
					<div class="placeholder-img mb-3" style="height: 280px;">이미지 없음</div>
				<% } else { %> 
					<!-- 카드에 이미지가 있을 경우  -->
					<img class="img-fluid mb-3" alt="게시판이미지" src="/images/upload/<%= board.file %>">
				<% } %>

				<div class="post-content"><%= board.content %></div>
				<div class="mt-4 d-flex gap-2">
					<a class="btn btn-outline-secondary" href="#">목록</a>
					<a class="btn btn-brand" href="/board/modify/<%= board.author.id %>/<%= board.id %>">수정</a>
					<a class="btn btn-brand" href="/board/delete/<%= board.author.id %>/<%= board.id %>">삭제</a>
				</div>
			</div>
		</article>

		<!-- 댓글 섹션  -->
		<section class="mt-5">
			<h5 class="mb-3">댓글</h5>

			<!-- 댓글 10개 (더미) -->
			<ul class="list-group mb-4">
				<% comments.forEach(c => { %>
				<li class="list-group-item">
					<strong><%= c.author.name %></strong><span class="small text-muted"> · <%= c.createdAt.toLocaleDateString() %></span>
					<p class="mt-2 mb-0"><%= c.content %></p>
					<% if(c.author.id == userId) { %>
						<form action="/board/info/comment/delete/<%= c.author.id %>/<%= c.post.id %>/<%= c.id %>" method="post" class="mt-3">
							<button type="submit" class="btn btn-brand">삭제</button>
						</form>
					<% } %>
				</li>
				<% }) %>
			</ul>

			<!-- 페이징 -->
			<nav aria-label="댓글 페이지" class="mt-3">
				<ul class="pagination justify-content-center">
					<!-- 이전 -->
					<li class="page-item disabled">
						<a class="page-link" href="#">이전</a>
					</li>

					<!-- 페이지 번호들 (더미) -->
					<li class="page-item active"><a class="page-link" href="#">1</a></li>
					<li class="page-item"><a class="page-link" href="#">2</a></li>
					<li class="page-item"><a class="page-link" href="#">3</a></li>
					<li class="page-item"><a class="page-link" href="#">4</a></li>
					<li class="page-item"><a class="page-link" href="#">5</a></li>
					<li class="page-item"><a class="page-link" href="#">6</a></li>
					<li class="page-item"><a class="page-link" href="#">7</a></li>
					<li class="page-item"><a class="page-link" href="#">8</a></li>
					<li class="page-item"><a class="page-link" href="#">9</a></li>
					<li class="page-item"><a class="page-link" href="#">10</a></li>

					<!-- 다음 -->
					<li class="page-item">
						<a class="page-link" href="#">다음</a>
					</li>
				</ul>
			</nav>

			<!-- 댓글 작성 폼 -->
			<div class="card mt-4">
				<div class="card-body">
					<h6 class="card-title mb-3">댓글 작성</h6>
					<!-- <form onsubmit="return false;"> -->
					<form action="/board/info/comment/<%= board.id %>" method="post">
						<div class="mb-3">
							<textarea class="form-control" name="content" rows="3" placeholder="댓글을 입력하세요"></textarea>
						</div>
						<button type="submit" class="btn btn-brown">등록</button>
					</form>
				</div>
			</div>
		</section>

	</main>

	<!-- 푸터 -->
	<%- include('../partials/footer') %>

	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>